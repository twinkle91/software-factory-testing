{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.next",
      "!!node_modules",
      "!!storybook-static",
      "!!data/db.json",
      "!!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
